<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#07111b"><meta name="color-scheme" content="dark"><title>AI Infinity — Creator OS</title><style>
:root{--bg:#07111b;--panel:#0b1723;--panel2:#0e1d2a;--line:#1d3344;--text:#eef7ff;--muted:#8ca4b7;--accent:#68e7ff;--accent2:#8b7cff;--good:#68e4a1;--warn:#ffd27b;--bad:#ff7c92;--shadow:0 22px 80px rgba(0,0,0,.36);--radius:18px}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:radial-gradient(circle at 0 0,#162b44 0,transparent 32%),radial-gradient(circle at 100% 0,#193038 0,transparent 26%),var(--bg);color:var(--text);font:14px/1.48 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer}.shell{display:grid;grid-template-columns:252px minmax(0,1fr);min-height:100vh}.sidebar{position:sticky;top:0;height:100vh;padding:18px 14px;border-right:1px solid var(--line);background:rgba(5,12,19,.78);backdrop-filter:blur(22px);z-index:30}.brand{display:flex;gap:10px;align-items:center;padding:9px 10px 16px}.mark{height:38px;width:38px;border:1px solid #30506b;border-radius:12px;display:grid;place-items:center;background:linear-gradient(135deg,#10283a,#10142d);font-size:21px;font-weight:900}.brand b{font-size:17px}.brand span{display:block;color:var(--muted);font-size:11px}.nav{display:grid;gap:4px}.nav button{display:flex;align-items:center;gap:10px;width:100%;border:1px solid transparent;background:transparent;color:#b5c8d9;border-radius:12px;padding:10px 11px;text-align:left}.nav button:hover,.nav button.active{border-color:#213a4c;background:linear-gradient(90deg,rgba(104,231,255,.12),rgba(139,124,255,.08));color:#fff}.ico{width:20px;text-align:center}.side-bottom{position:absolute;left:14px;right:14px;bottom:16px}.mini{padding:12px;border:1px solid var(--line);border-radius:14px;background:rgba(14,29,42,.66);color:var(--muted);font-size:11px}.main{min-width:0}.topbar{position:sticky;top:0;z-index:20;height:68px;border-bottom:1px solid var(--line);background:rgba(7,17,27,.83);backdrop-filter:blur(18px);display:flex;align-items:center;justify-content:space-between;padding:0 22px}.title{font-weight:800;letter-spacing:-.2px}.top-actions{display:flex;align-items:center;gap:8px}.pill{border:1px solid var(--line);border-radius:999px;padding:7px 10px;color:var(--muted);font-size:11px;background:rgba(11,23,35,.8)}.live{color:var(--good)}.work{display:grid;grid-template-columns:minmax(0,1fr) 318px;gap:16px;max-width:1500px;margin:auto;padding:18px 20px 88px}.content{min-width:0}.rail{display:grid;gap:12px;align-content:start}.card{border:1px solid var(--line);background:linear-gradient(180deg,rgba(14,29,42,.96),rgba(10,22,33,.93));border-radius:var(--radius);box-shadow:var(--shadow);padding:18px}.hero{padding:24px;background:radial-gradient(circle at 8% 0,rgba(104,231,255,.11),transparent 36%),radial-gradient(circle at 94% 16%,rgba(139,124,255,.12),transparent 28%),linear-gradient(180deg,#0d1b28,#09131e)}.eyebrow{color:var(--accent);font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.hero h1{font-size:clamp(27px,4vw,43px);line-height:1.03;margin:8px 0}.hero p{max-width:780px;color:#afc1cf;margin:0}.command-row{display:grid;grid-template-columns:1fr auto;gap:10px;margin-top:18px}.command{min-height:104px;width:100%;resize:vertical;border:1px solid #29485d;background:#06101a;color:#fff;border-radius:14px;padding:14px;outline:none}.command:focus,.field:focus{border-color:#4d9cb6;box-shadow:0 0 0 3px rgba(104,231,255,.08)}.primary{border:1px solid #76ecff;background:linear-gradient(135deg,#79ecff,#a7d8ff);color:#06101a;font-weight:800}.btn{border:1px solid #294457;background:#0b1824;color:#edf7ff;border-radius:11px;padding:10px 13px}.btn:hover{filter:brightness(1.12)}.danger{border-color:#713347;color:#ffb4c2}.muted{color:var(--muted)}.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:12px}.metric{border:1px solid var(--line);background:rgba(7,17,27,.6);border-radius:14px;padding:13px}.metric span{display:block;color:var(--muted);font-size:11px}.metric b{display:block;font-size:22px;margin-top:4px}.section{margin-top:14px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}.section-head h2{font-size:16px;margin:0}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.list{display:grid;gap:8px}.item{border:1px solid var(--line);border-radius:13px;padding:12px;background:rgba(7,17,27,.45)}.item strong{font-size:13px}.row{display:flex;align-items:center;justify-content:space-between;gap:12px}.badge{padding:4px 8px;border-radius:999px;background:#112536;color:#9fb9ca;font-size:10px}.good{color:var(--good)}.warn{color:var(--warn)}.bad{color:var(--bad)}.link{color:#a9ddff;text-decoration:none}.link:hover{text-decoration:underline}.field{width:100%;min-height:44px;background:#06101a;color:#fff;border:1px solid #294457;border-radius:12px;padding:10px 12px;outline:none}.fieldarea{min-height:100px;resize:vertical}.formgrid{display:grid;gap:9px}.label{font-size:11px;color:var(--muted);margin-bottom:5px}.toolbar{display:flex;gap:7px;flex-wrap:wrap}.out{white-space:pre-wrap;word-break:break-word;max-height:490px;overflow:auto;background:#06101a;border:1px solid #172a39;border-radius:12px;padding:12px;font-size:12px}.progress{height:7px;border-radius:99px;background:#142735;overflow:hidden}.progress i{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:99px}.empty{padding:23px;text-align:center;color:var(--muted);border:1px dashed #294457;border-radius:14px}.chat{min-height:calc(100vh - 105px);display:flex;flex-direction:column}.messages{flex:1;display:grid;align-content:start;gap:10px;max-height:62vh;overflow:auto;padding:4px}.msg{max-width:84%;padding:11px 13px;border-radius:14px;line-height:1.5}.msg.ai{background:#102131;border:1px solid #1e3749}.msg.user{margin-left:auto;background:#eaf8ff;color:#07111b}.chatbar{display:grid;grid-template-columns:1fr auto auto;gap:8px;margin-top:12px}.chatbar textarea{min-height:58px;resize:vertical;background:#06101a;color:#fff;border:1px solid #294457;border-radius:12px;padding:12px}.mobile{display:none}.shortcut{color:#68849a;font-size:10px;margin-top:7px}.hide{disp