# Copy to .env on the production server and fill in the domain.
AI_INFINITY_DOMAIN=ai-infinity.example.com
CADDY_EMAIL=
AI_INFINITY_PUBLIC_URL=https://ai-infinity.example.com

AI_INFINITY_DATA_DIR=/var/lib/ai-infinity
AI_INFINITY_PERSISTENCE_MODE=portable-volume
AI_INFINITY_STORAGE_MODE=local
AI_INFINITY_EXTERNAL_WORKER=true

# Optional S3-compatible object storage for a second durable media copy.
# AI_INFINITY_STORAGE_MODE=s3-compatible
# AI_INFINITY_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# AI_INFINITY_S3_BUCKET=ai-infinity
# AI_INFINITY_S3_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Runtime safety / throughput bounds.
AI_INFINITY_MAX_HEAVY_JOBS=1
AI_INFINITY_FFMPEG_THREADS=2
AI_INFINITY_FFMPEG_FILTER_THREADS=2
AI_INFINITY_MEMORY_GUARD_PERCENT=0.80
AI_INFINITY_MEMORY_RESERVE_MB=256
AI_INFINITY_QUEUE_LEASE_SECONDS=1800
AI_INFINITY_MAX_RETRIES=2

# Optional provider credentials are configured only when that provider is actually used.
