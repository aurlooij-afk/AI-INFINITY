_id=? AND status='active'", (uid3,)).fetchone()[0]
        published = c.execute("SELECT COUNT(*) FROM ai3700_projects WHERE user_id=? AND stage='published'", (uid3,)).fetchone()[0]
        publish_drafts = c.execute("SELECT COUNT(*) FROM ai3700_publish_queue WHERE user_id=? AND status='draft_ready'", (uid3,)).fetchone()[0]
    metrics = _3601_metrics()
    return {
        "user_id": uid3,
        "projects": {"total": int(total_projects), "active": int(active_projects), "published": int(published)},
        "publishing": {"drafts": int(publish_drafts)},
        "execution": {
            "verified_earnings": metrics.get("verified_earnings", 0),
            "pending_verified_funds": metrics.get("pending_verified_funds", 0),
            "transferable_balance": metrics.get("transferable_balance", 0),
            "active_opportunities": metrics.get("active_opportunities", 0),
        },
        "truthful": True,
    }


