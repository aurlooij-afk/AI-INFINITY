    }


@app.post("/infinity/3700/command")
def infinity3700_command(payload: Dict[str, Any], request: FastAPIRequest):
    uid3 = _3700_user(request)
    command = str(payload.get("command") or "").strip()[:12000]
    if not command:
        raise HTTPException(400, "command is required")
    approved = bool(payload.get("approved", False))
    result = _3603_operating_command(command, user_id=uid3, approved=approved)
    result["platform_version"] = FINAL3700_VERSION
    result["truthful"] = True
    return result


