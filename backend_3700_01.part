# ============================================================================
# TARGET-2050.3700 — EXTRAORDINARY CREATOR-OS PLATFORM CLOSURE
# A coherent public workspace layered over the cumulative AI Infinity engines.
# Existing execution, work, media, memory, economy and governance systems are
# preserved; this layer gives them a single durable product surface.
# ============================================================================

FINAL3700_VERSION = "TARGET-2050.3700"
FINAL3700_BUILD = "EXTRAORDINARY-CREATOR-OS-PLATFORM-CLOSURE"
FINAL3700_PREVIOUS = FINAL3603_VERSION

with _db_lock, db() as _c3700:
    _c3700.executescript("""
    CREATE TABLE IF NOT EXISTS ai3700_projects (
        project_id TEXT PRIMARY KEY,
        user_id TEXT NOT NULL,
        name TEXT NOT NULL,
        objective TEXT NOT NULL,
        stage TEXT NOT NULL DEFAULT 'idea',
        status TEXT NOT NULL DEFAULT 'active',
        metadata_json TEXT NOT NULL DEFAULT '{}',
        created_at REAL NOT NULL,
        updated_at REAL NOT NULL
    );
    CREATE INDEX IF NOT EXISTS idx_ai3700_projects_user ON ai3700_projects(user_id, updated_at);

    CREATE TABLE IF NOT EXISTS ai3700_brand (
        user_id TEXT PRIMARY KEY,
        brand_name TEXT NOT NULL DEFAULT '',
        voice TEXT NOT NULL DEFAULT '',
        audience TEXT NOT NULL DEFAULT '',
        positioning TEXT NOT NULL DEFAULT '',
        visual_notes TEXT NOT NULL DEFAULT '',
        updated_at REAL NOT NULL
    );

    CREATE TABLE IF NOT EXISTS ai3700_publish_queue (
        publish_id TEXT PRIMARY KEY,
        user_id TEXT NOT NULL,
        project_id TEXT,
        title TEXT NOT NULL,
        target TEXT NOT NULL,
        status TEXT NOT NULL DEFAULT 'draft_ready',
        payload_json TEXT NOT NULL DEFAULT '{}',
        created_at REAL NOT NULL,
        updated_at REAL NOT NULL
    );
    CREATE INDEX IF NOT EXISTS idx_ai3700_publish_user ON ai3700_publish_queue(user_id, updated_at);
    """)


def _3700_user(request: FastAPIRequest) -> str:
    return _3603_session_user(request)


def _3700_json(value: Any) -> str:
    return json.dumps(value, ensure_ascii=False, separators=(",", ":"), default=str)


def _3700_project_row(row: sqlite3.Row) -> Dict[str, Any]:
    d = dict(row)
    try:
        d["metadata"] = json.loads(d.pop("metadata_json", "{}") or "{}")
    except Exception:
        d["metadata"] = {}
    return d


def _3700_projects(user_id: str, limit: int = 100) -> List[Dict[str, Any]]:
    with _db_lock, db() as c:
        rows = c.execute(
            "SELECT * FROM ai3700_projects WHERE user_id=? ORDER BY updated_at DESC LIMIT ?",
            (user_id, max(1, min(limit, 200))),
        ).fetchall()
    return [_3700_project_row(r) for r in rows]


def _3700_brand_get(user_id: str) -> Dict[str, Any]:
    with _db_lock, db() as c:
        row = c.execute("SELECT * FROM ai3700_brand WHERE user_id=?", (user_id,)).fetchone()
    if not row:
        return {"user_id": user_id, "brand_name": "AI Infinity", "voice": "clear, capable, trustworthy", "audience": "people building useful things", "positioning": "one operating workspace for turning ideas into verified outcomes", "visual_notes": "premium, calm, futuristic, readable"}
    d = dict(row)
    d.pop("updated_at", None)
    return d


def _3700_dashboard_payload(user_id: str) -> Dict[str, Any]:
    readiness = _3601_real_readiness()
    metrics = _3601_metrics()
    try:
        tasks = _gp_fixed_price_rows(12)
    except Exception:
        tasks = []
    try:
        activity = infinity3603_operating_activity(16).get("activity", [])
    except Exception:
        activity = []
    projects = _3700_projects(user_id, 8)
    with _db_lock, db() as c:
        drafts = c.execute("SELECT COUNT(*) FROM ai3700_publish_queue WHERE user_id=? AND status='draft_ready'", (user_id,)).fetchone()[0]
        queued = c.execute("SELECT COUNT(*) FROM ai3700_publish_queue WHERE user_id=? AND status='queued'", (user_id,)).fetchone()[0]
    return {
        "version": FINAL3700_VERSION,
        "build": FINAL3700_BUILD,
        "user_id": user_id,
        "readiness": readiness,
        "metrics": metrics,
        "tasks": tasks,
        "projects": projects,
        "brand": _3700_brand_get(user_id),
        "publish": {"drafts": int(drafts), "queued": int(queued)},
        "activity": activity,
        "truthful": True,
    }


@app.get("/infinity/3700/health")
def infinity3700_health():
    with _db_lock, db() as c:
        tables = {}
        for name in ("ai3700_projects", "ai3700_brand", "ai3700_publish_queue"):
            tables[name] = bool(c.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", (name,)).fetchone())
    return {
        "status": "healthy",
        "version": FINAL3700_VERSION,
        "build": FINAL3700_BUILD,
        "database": True,
        "platform_shell": True,
        "creator_workspace": True,
        "durable_projects": tables["ai3700_projects"],
        "durable_brand": tables["ai3700_brand"],
        "durable_publish_queue": tables["ai3700_publish_queue"],
        "truthful": True,
    }


@app.get("/infinity/3700/dashboard")
def infinity3700_dashboard(request: FastAPIRequest):
    return _3700_dashboard_payload(_3700_user(request))


@app.get("/infinity/3700/projects")
def infinity3700_projects(request: FastAPIRequest):
    uid3 = _3700_user(request)
    return {"user_id": uid3, "projects": _3700_projects(uid3), "truthful": True}


@app.post("/infinity/3700/projects")
def infinity3700_project_create(payload: Dict[str, Any], request: FastAPIRequest):
    uid3 = _3700_user(request)
    name = str(payload.get("name") or "Untitled Infinity Project").strip()[:180]
    objective = str(payload.get("objective") or "").strip()[:6000]
    if not objective:
        raise HTTPException(400, "objective is required")
    stage = str(payload.get("stage") or "idea").strip().lower()
    if stage not in {"idea", "planning", "production", "review", "published", "archived"}:
        stage = "idea"
    pid = uid("project")
    t = now()
    metadata = payload.get("metadata") if isinstance(payload.get("metadata"), dict) else {}
    with _db_lock, db() as c:
        c.execute(
            "INSERT INTO ai3700_projects(project_id,user_id,name,objective,stage,status,metadata_json,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?)",
            (pid, uid3, name, objective, stage, "active", _3700_json(metadata), t, t),
        )
    try:
        _gp_activity("project", f"Project created: {name}", "completed", pid)
    except Exception:
        pass
    return {"status": "created", "project": _3700_projects(uid3, 1)[0], "truthful": True}
